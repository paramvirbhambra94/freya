{
  "headers": [
    {
      "source": "/.well-known/webauthn",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    }
  ],
  "redirects": [
    {
      "source": "/app",
      "destination": "https://github.com/paramvirbhambra94/freya/releases/latest/download/freya.apk",
      "permanent": false
    },
    {
      "source": "/freya.apk",
      "destination": "https://github.com/paramvirbhambra94/freya/releases/latest/download/freya.apk",
      "permanent": false
    }
  ],
  "functions": {
    "api/state.js": {
      "maxDuration": 60
    },
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/memory.js": {
      "maxDuration": 60
    }
  },
  "regions": [
    "lhr1"
  ]
}
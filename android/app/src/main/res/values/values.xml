<?xml version="1.0" encoding="utf-8"?>
<resources>
  <string name="app_name">FREYA</string>
  <string name="talk">Talk to FREYA</string>
  <color name="bg">#0B0805</color>
  <color name="gold">#E8B45A</color>
  <style name="Theme.Freya" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@color/bg</item>
    <item name="android:colorBackground">@color/bg</item>
    <item name="android:colorAccent">@color/gold</item>
    <item name="android:statusBarColor">@color/bg</item>
    <item name="android:navigationBarColor">@color/bg</item>
    <item name="android:windowLightStatusBar">false</item>
    <!-- Android 12+ splash: the HUD ring draws itself in around the F -->
    <item name="android:windowSplashScreenBackground">@color/bg</item>
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_anim</item>
    <item name="android:windowSplashScreenAnimationDuration">1000</item>
  </style>
  <string name="asset_statements" translatable="false">[{\"include\": \"https://freya-black.vercel.app/.well-known/assetlinks.json\"}]</string>
</resources>
